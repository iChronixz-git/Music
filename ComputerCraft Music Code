-- ===============================
local scroll = 0
local selected = 1
local volume = 1.0

-- Playback state
local playing = false
local paused = false
local stopFlag = false
local currentSong = nil
local response = nil
local streamPos = 0 -- Audio position in bytes (6000 bytes = 1 sec)

-- ========== SPEAKER HELPERS ==========
local function stopAll()
    for _, spk in ipairs(speakers) do
        spk.stop()
    end
end

local function playAudioOnAll(buffer)
    local allSubmitted = true
    for _, spk in ipairs(speakers) do
        local ok = spk.playAudio(buffer)
        if not ok then
            allSubmitted = false
        end
    end
    return allSubmitted
end

-- ========== UI HELPERS ==========
local function centerWrite(text, y, color)
    local w = select(1, term.getSize())
    term.setTextColor(color or colors.white)
    local x = math.floor((w - #tostring(text)) / 2) + 1
    if x < 1 then x = 1 end
    term.setCursorPos(x, y)
    term.write(tostring(text))
end

local function drawButton(x, y, w, text, bg)
    term.setBackgroundColor(bg or colors.gray)
    term.setTextColor(colors.white)
    term.setCursorPos(x, y)
    term.write(string.rep(" ", w))
    local tx = x + math.floor((w - #text) / 2)
    term.setCursorPos(tx, y)
    term.write(text)
end

local function applyVolume(buffer)
    if volume == 1.0 then return buffer end
    local new = {}
    for i = 1, #buffer do
        local s = buffer[i] * volume
        if s > 127 then
            s = 127
        elseif s < -128 then
            s = -128
        end
        new[i] = math.floor(s)
    end
    return new
end

-- Fetch stream HTTP helper
local function fetchStream(url)
    http.request({ url = url, binary = true })
    local timer = os.startTimer(15)
    while true do
        local ev, p1, p2 = os.pullEvent()
        if ev == "http_success" and p1 == url then
            return p2
        elseif ev == "http_failure" and p1 == url then
            return nil
        elseif ev == "timer" and p1 == timer then
            return nil
        end
    end
end

-- ========== SEEKING HELPERS ==========
local function seekForward(seconds)
    if not response or not playing then return end
    stopAll()
    local bytesToSkip = seconds * 6000
    local skipped = 0
    while skipped < bytesToSkip do
        local toRead = math.min(16384, bytesToSkip - skipped)
        local chunk = response.read(toRead)
        if not chunk then break end
        skipped = skipped + #chunk
    end
    streamPos = streamPos + skipped
end

local function seekBackward(seconds)
    if not response or not playing then return end
    stopAll()
    local bytesToSkip = seconds * 6000
    local targetPos = math.max(0, streamPos - bytesToSkip)
    
    pcall(function() response.close() end)
    response = fetchStream(songs[selected].url)
    
    if not response then
        playing = false
        currentSong = "Seek failed"
        draw()
        return
    end

    decoder = dfpwm.make_decoder()
    local skipped = 0
    while skipped < targetPos do
        local toRead = math.min(16384, targetPos - skipped)
        local chunk = response.read(toRead)
        if not chunk then break end
        skipped = skipped + #chunk
    end
    streamPos = skipped
end

-- ========== DRAW ==========
local function draw()
    local w, h = term.getSize()
    term.setBackgroundColor(colors.black)
    term.clear()

    centerWrite("=== STREAMING MUSIC PLAYER ===", 1, colors.yellow)
    centerWrite(string.format("Speakers Connected: %d", #speakers), 2, colors.gray)

    local listHeight = h - 10
    local maxScroll = math.max(0, #songs - listHeight)
    scroll = math.max(0, math.min(scroll, maxScroll))

    for i = 1, listHeight do
        local idx = i + scroll
        local y = 2 + i
        if songs[idx] then
            if idx == selected then
                term.setBackgroundColor(colors.blue)
                term.setTextColor(colors.white)
            else
                term.setBackgroundColor(colors.black)
                term.setTextColor(colors.lime)
            end
            term.setCursorPos(2, y)
            term.write(string.rep(" ", w - 2))
            term.setCursorPos(3, y)
            local name = songs[idx].name
            if #name > w - 4 then
                name = name:sub(1, w - 7) .. "..."
            end
            term.write(name)
        end
    end

    term.setBackgroundColor(colors.black)
    centerWrite("------------------------------", h - 5, colors.gray)

    if playing and currentSong then
        centerWrite("Now Playing: " .. currentSong, h - 4, colors.lightBlue)
        if paused then
            centerWrite("[ PAUSED ]", h - 3, colors.orange)
        else
            centerWrite("[ PLAYING ]", h - 3, colors.lime)
        end
    else
        centerWrite("Now Playing: Nothing", h - 4, colors.gray)
    end

    -- Row h-1: Volume bar
    drawButton(2, h - 1, 6, "Vol-", colors.brown)
    centerWrite(string.format("Volume: %.1fx", volume), h - 1, colors.yellow)
    drawButton(w - 7, h - 1, 6, "Vol+", colors.brown)

    -- Row h: Playback Controls: [-15s] [<] [|| / >] [>] [+15s] [Stop]
    local playPauseText = (playing and not paused) and "||" or " > "
    local playPauseBg = (playing and not paused) and colors.orange or colors.green

    drawButton(2,  h, 5, "-15s", colors.gray)
    drawButton(8,  h, 4, "<", colors.gray)
    drawButton(13, h, 6, playPauseText, playPauseBg)
    drawButton(20, h, 4, ">", colors.gray)
    drawButton(25, h, 5, "+15s", colors.gray)
    drawButton(31, h, 6, "Stop", colors.red)
end

-- ========== HANDLE MONITOR INPUT ==========
local function handleTouch(x, y)
    local w, h = term.getSize()
    local listHeight = h - 10

    -- Select song via list click
    if y >= 3 and y <= 2 + listHeight then
        local idx = (y - 2) + scroll
        if songs[idx] then
            selected = idx
            draw()
        end
    end

    -- VOLUME - BUTTON
    if y == h - 1 and x >= 2 and x <= 7 then
        volume = math.max(0.2, math.floor((volume - 0.2) * 10 + 0.5) / 10)
        draw()
    end

    -- VOLUME + BUTTON
    if y == h - 1 and x >= w - 7 and x <= w - 2 then
        volume = math.min(3.0, math.floor((volume + 0.2) * 10 + 0.5) / 10)
        draw()
    end

    -- REWIND 15 SECONDS (-15s)
    if y == h and x >= 2 and x <= 6 then
        seekBackward(15)
        draw()
    end

    -- PREVIOUS TRACK BUTTON (<)
    if y == h and x >= 8 and x <= 11 then
        selected = selected - 1
        if selected < 1 then selected = #songs end
        if songs[selected] then startStream(songs[selected]) end
    end

    -- PLAY / PAUSE TOGGLE
    if y == h and x >= 13 and x <= 18 then
        if not playing and songs[selected] then
            startStream(songs[selected])
        elseif playing then
            paused = not paused
            draw()
        end
    end

    -- NEXT TRACK BUTTON (>)
    if y == h and x >= 20 and x <= 23 then
        selected = selected + 1
        if selected > #songs then selected = 1 end
        if songs[selected] then startStream(songs[selected]) end
    end

    -- FAST FORWARD 15 SECONDS (+15s)
    if y == h and x >= 25 and x <= 29 then
        seekForward(15)
        draw()
    end

    -- STOP BUTTON
    if y == h and x >= 31 and x <= 36 then
        stopFlag = true
        stopAll()
        if response then
            pcall(function() response.close() end)
            response = nil
        end
        playing = false
        paused = false
        currentSong = nil
        streamPos = 0
        draw()
    end
end

-- ========== START STREAM ==========
function startStream(song)
    stopFlag = true
    stopAll()
    if response then
        pcall(function() response.close() end)
        response = nil
    end
    sleep(0.2)

    stopFlag = false
    paused = false
    playing = true
    currentSong = song.name
    streamPos = 0
    decoder = dfpwm.make_decoder()
    draw()

    response = fetchStream(song.url)
    if not response then
        playing = false
        currentSong = "Load failed"
        draw()
    end
end

-- ========== MAIN LOOP ==========
draw()
while true do
    if playing and not paused and response and not stopFlag then
        local chunk = response.read(16 * 1024)
        if chunk then
            streamPos = streamPos + #chunk
            local buffer = decoder(chunk)
            buffer = applyVolume(buffer)

            local submitted = false
            while not submitted do
                if stopFlag or not playing then break end

                if paused then
                    local event, p1, p2, p3 = os.pullEvent()
                    if event == "monitor_touch" then
                        handleTouch(p2, p3)
                    elseif event == "mouse_scroll" then
                        scroll = scroll - p1
                        draw()
                    end
                else
                    submitted = playAudioOnAll(buffer)
                    if not submitted then
                        local event, p1, p2, p3 = os.pullEvent()
                        if event == "speaker_audio_empty" then
                            -- Audio buffer clear, retry broadcast
                        elseif event == "monitor_touch" then
                            handleTouch(p2, p3)
                        elseif event == "mouse_scroll" then
                            scroll = scroll - p1
                            draw()
                        end
                    end
                end
            end
        else
            -- END OF SONG: Auto-advance to next track
            pcall(function() response.close() end)
            response = nil
            stopAll()
            
            selected = selected + 1
            if selected > #songs then selected = 1 end
            if songs[selected] then
                startStream(songs[selected])
            else
                playing = false
                paused = false
                currentSong = nil
                streamPos = 0
                draw()
            end
        end
    else
        local event, p1, p2, p3 = os.pullEvent()
        if event == "monitor_touch" then
            handleTouch(p2, p3)
        elseif event == "mouse_scroll" then
            scroll = scroll - p1
            draw()
        end
    end
end
